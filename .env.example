# Copy this file to .env and adjust if needed.
# .env is git-ignored; never commit real credentials.

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=shortvideo_risk
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=change_me_local_dev_only

# --- Paths ---
# SOURCE_DATA_DIR: where you place the raw source files locally before running
# scripts/ingest.py. Never committed (see .gitignore) — get the files per
# docs/data-sources-setup.md.
SOURCE_DATA_DIR=./data_sources
RAW_DATA_DIR=./raw
STAGING_DATA_DIR=./staging
CURATED_DATA_DIR=./curated

# --- Airflow (placeholders for later-day orchestration work) ---
AIRFLOW_UID=50000
