# Copy this file to .env and adjust if needed.
# .env is git-ignored; never commit real credentials.

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=shortvideo_risk
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=change_me_local_dev_only

# --- Paths (used by ingestion/transformation scripts, added in later days) ---
RAW_DATA_DIR=./raw
STAGING_DATA_DIR=./staging
CURATED_DATA_DIR=./curated

# --- Airflow (placeholders for later-day orchestration work) ---
AIRFLOW_UID=50000
