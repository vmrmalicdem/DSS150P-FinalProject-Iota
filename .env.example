# Copy this file to .env and adjust if needed.
# .env is git-ignored; never commit real credentials.

# --- PostgreSQL ---
# Use localhost when running scripts on your own machine.
# docker-compose.yml overrides this to 'postgres' inside containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shortvideo_risk
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=change_me_local_dev_only

# --- Paths ---
# SOURCE_DATA_DIR: where you place the raw source files locally before running
# scripts/ingest.py. Never committed (see .gitignore) - get the files per
# docs/data-sources-setup.md.
SOURCE_DATA_DIR=./data_sources
RAW_DATA_DIR=./raw
STAGING_DATA_DIR=./staging
CURATED_DATA_DIR=./curated

# --- Airflow (placeholders for later-day orchestration work) ---
AIRFLOW_UID=50000

# --- Feature definitions (see docs/transformation-spec.md, section 5) ---
LATE_NIGHT_START_HOUR=2
LATE_NIGHT_END_HOUR=4
SESSION_GAP_SECONDS=900
MIN_USER_EVENTS=5
