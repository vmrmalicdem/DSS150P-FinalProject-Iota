# Copy this file to .env and adjust if needed.
# .env is git-ignored; never commit real credentials.

# --- PostgreSQL ---
# Use localhost when running scripts on your own machine.
# docker-compose.yml overrides this to 'postgres' inside containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shortvideo_risk
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=change_me_local_dev_only

# --- Paths ---
# SOURCE_DATA_DIR: where you place the raw source files locally before running
# scripts/ingest.py. Never committed (see .gitignore) - get the files per
# docs/data-sources-setup.md.
SOURCE_DATA_DIR=./data
RAW_DATA_DIR=./raw
STAGING_DATA_DIR=./staging
CURATED_DATA_DIR=./curated

# --- Airflow (docker-compose.yml) ---
# AIRFLOW_UID: on Linux set to your host user id (run `id -u`) so files written to the
# mounted raw/, staging/, curated/ and logs/ folders stay yours. Keep 50000 on Windows/macOS.
AIRFLOW_UID=50000
AIRFLOW_WEBSERVER_PORT=8080
# Airflow metadata database (separate from the warehouse above).
AIRFLOW_DB_PASSWORD=change_me_airflow_db_local_only
# Login for the Airflow UI.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow_ui_local_only

# --- Feature definitions (see docs/transformation-spec.md, section 5) ---
LATE_NIGHT_START_HOUR=2
LATE_NIGHT_END_HOUR=4
SESSION_GAP_SECONDS=900
MIN_USER_EVENTS=5