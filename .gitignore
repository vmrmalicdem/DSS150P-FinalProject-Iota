# Environment / secrets
.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Airflow local runtime artifacts
airflow.db
airflow.cfg
airflow-webserver.pid
logs/

# Data (raw/staging/curated hold real or generated data; keep the folders, not the contents)
raw/*
!raw/.gitkeep
staging/*
!staging/.gitkeep
curated/*
!curated/.gitkeep

# Local source-data input for ingest.py. Never committed - the interaction CSV
# is ~160MB, over GitHub's per-file limit, and raw source data shouldn't live
# in git regardless of size. Each teammate places their own copy here locally.
data_sources/

# OS / editor
.DS_Store
.vscode/
.idea/

# Docker
*.log
